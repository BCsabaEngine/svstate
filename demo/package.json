{
	"name": "svstate-demo",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22",
		"npm": ">=9"
	},
	"scripts": {
		"dev": "vite dev --host --open",
		"build": "vite build",
		"ts:check": "svelte-check --tsconfig ./tsconfig.json",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write --list-different .",
		"lint:check": "eslint .",
		"lint:fix": "eslint --fix .",
		"npm:reinstall": "rm -rf ./node_modules && rm -f ./package-lock.json && npm i && npm i",
		"all": "node --run format:fix && node --run lint:fix && node --run ts:check && node --run build"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tsconfig/svelte": "^5.0.8",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-svelte": "^3.23.0",
		"eslint-plugin-unicorn": "^73.0.0",
		"postcss": "^8.5.28",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"svelte-preprocess": "^6.0.5",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"svelte": "^5.57.1",
		"zod": "^4.6.5"
	}
}
